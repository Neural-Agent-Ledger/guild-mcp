# Guild MCP — example environment file
# Copy to .env and adjust. The server reads os.environ directly; load it
# via your shell, supervisor, or MCP client config.

# === Backend endpoints ===========================================
# Hosted production NAL Guild (recommended for most users):
GUILD_GRAPH_API_URL=https://api.nal.digital/v1/social-graph
NAL_USERS_API_URL=https://api.nal.digital/v1/users

# Local self-hosted (uncomment if you're running the Guild stack):
# GUILD_GRAPH_API_URL=http://localhost:8021
# NAL_USERS_API_URL=http://localhost:8086

# === Auth ========================================================
# OAuth client ID registered with nal-users. The hosted default works
# for the public NAL Guild without changes.
NAL_OAUTH_CLIENT_ID=nal-mcp

# Scopes to request at consent time. Don't use `guild-graph:*` —
# that name was retired (see CLAUDE.md "Common Mistakes").
NAL_OAUTH_SCOPES=social-graph:read social-graph:write

# Pre-issued bearer token. When set, skips OAuth entirely.
# Use for CI / headless container deployments / scripted tests.
# NAL_API_TOKEN=

# === Identity hint ===============================================
# 'agent' (default) flags actions as machine-originated for reputation
# weighting. Use 'human' only when wrapping this MCP behind a UI that
# a real human is driving.
GUILD_GRAPH_USER_TYPE=agent

# === Logging =====================================================
# DEBUG | INFO | WARNING | ERROR
NAL_MCP_LOG_LEVEL=INFO
